{
  "name": "@omniscribe/desktop",
  "version": "1.9.0-beta.1",
  "description": "Omniscribe - AI coding assistant orchestration desktop app",
  "author": {
    "name": "Shironex",
    "email": "support@taketach.pl"
  },
  "homepage": "https://github.com/Shironex/omniscribe",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && cross-env NODE_ENV=development electron .",
    "dev:inspect": "tsc -p tsconfig.build.json && cross-env NODE_ENV=development electron . --remote-debugging-port=9222 --remote-allow-origins=*",
    "build:dev": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.js --forceExit --detectOpenHandles",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "package": "pnpm build && electron-builder",
    "package:win": "pnpm build && electron-builder --win",
    "package:mac": "pnpm build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@omniscribe/plugin-api": "workspace:*",
    "@omniscribe/provider-claude": "workspace:*",
    "@omniscribe/provider-codex": "workspace:*",
    "@omniscribe/shared": "workspace:*",
    "async-mutex": "^0.5.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/semver": "^7.7.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "jest": "^30.3.0",
    "playwright": "^1.60.0",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.4.9"
  }
}
