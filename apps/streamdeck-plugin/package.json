{
  "name": "@omniscribe/streamdeck-plugin",
  "version": "1.7.0",
  "description": "Stream Deck plugin that launches Omniscribe AI sessions via omniscribe:// deep links",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "validate": "streamdeck validate com.taketach.omniscribe.sdPlugin",
    "package": "pnpm run build && streamdeck pack com.taketach.omniscribe.sdPlugin --force --output dist",
    "clean": "node -e \"require('fs').rmSync('com.taketach.omniscribe.sdPlugin/bin',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.4.0",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
