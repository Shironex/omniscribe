{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@omniscribe/shared": ["../../packages/shared/src"],
      "@omniscribe/shared/*": ["../../packages/shared/src/*"],
      "@omniscribe/ui": ["./src/lib/plugin-sdk.ts"],
      "@omniscribe/plugin-api": ["../../packages/plugin-api/src"],
      "@omniscribe/plugin-api/*": ["../../packages/plugin-api/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/src/**/*",
    "../../packages/plugin-api/src/**/*",
    "../../packages/plugins/provider-claude/src/frontend/**/*",
    "../../packages/plugins/provider-codex/src/frontend/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../packages/shared/src/**/*.spec.ts",
    "../../packages/plugin-api/src/**/*.spec.ts",
    "../../packages/plugin-api/src/__tests__/**/*"
  ]
}
