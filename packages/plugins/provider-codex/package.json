{
  "name": "@omniscribe/provider-codex",
  "version": "1.1.0-beta.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "omniscribe": {
    "id": "provider-codex",
    "type": "provider",
    "displayName": "Codex",
    "description": "OpenAI's Codex CLI for AI-assisted coding"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "node-pty": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@omniscribe/plugin-api": "workspace:*",
    "@omniscribe/shared": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.28",
    "jest": "^30.3.0",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  }
}
