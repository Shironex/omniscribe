{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "types": ["node"],
    "paths": {
      "@omniscribe/ui": ["../../apps/web/src/lib/plugin-sdk.ts"],
      "@omniscribe/plugin-api": ["../plugin-api/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "test", "src/frontend/**/*"]
}
