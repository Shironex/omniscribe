{
  "name": "omniscribe",
  "version": "1.9.0-beta.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "undici": ">=7.28.0 <8.0.0",
      "flatted": ">=3.4.2 <4.0.0",
      "tar@>=6": ">=7.5.21 <8.0.0",
      "hono": ">=4.12.27 <5.0.0",
      "fast-uri": ">=3.1.4 <4.0.0",
      "jest": ">=30.3.0 <30.4.0",
      "@hono/node-server": ">=2.0.5 <3.0.0",
      "@xmldom/xmldom": ">=0.8.12 <0.9.0",
      "axios": ">=1.18.0 <2.0.0",
      "follow-redirects": ">=1.16.0 <2.0.0",
      "lodash": ">=4.18.0 <5.0.0",
      "handlebars": ">=4.7.9 <5.0.0",
      "multer": ">=2.2.0 <3.0.0",
      "form-data": ">=4.0.6 <5.0.0",
      "body-parser": ">=2.3.0 <3.0.0",
      "js-yaml@>=4": ">=4.3.0 <5.0.0",
      "js-yaml@<4": ">=3.15.0 <4.0.0",
      "markdown-it": ">=14.2.0 <15.0.0",
      "linkify-it": ">=5.0.2 <6.0.0",
      "esbuild": ">=0.28.1 <0.29.0",
      "@babel/core": ">=7.29.6 <8.0.0",
      "serialize-javascript": ">=7.0.5 <8.0.0",
      "socket.io-parser": ">=4.2.6 <5.0.0",
      "engine.io": ">=6.6.7 <7.0.0",
      "picomatch": ">=4.0.4 <5.0.0",
      "file-type": ">=21.3.2 <23.0.0",
      "brace-expansion@>=5": ">=5.0.8 <6.0.0",
      "brace-expansion@^1.1.7": ">=1.1.16 <2.0.0",
      "brace-expansion@^2.0.1": ">=2.1.2 <3.0.0",
      "yaml@>=2": ">=2.8.3 <3.0.0",
      "@tootallnate/once": ">=3.0.1 <4.0.0",
      "postcss": ">=8.5.18 <9.0.0",
      "ip-address": ">=10.1.1 <11.0.0",
      "ws": ">=8.20.1 <9.0.0",
      "qs": ">=6.15.2 <7.0.0",
      "tmp": ">=0.2.7 <0.3.0",
      "sharp": ">=0.35.0 <1.0.0",
      "app-builder-lib": ">=26.15.0 <27.0.0",
      "builder-util-runtime": ">=9.7.0 <10.0.0"
    }
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n web,desktop -c cyan,yellow \"pnpm dev:web\" \"wait-on http://localhost:15174 && pnpm --filter @omniscribe/mcp-server build:dev && pnpm --filter @omniscribe/desktop dev\"",
    "dev:inspect": "pnpm build:packages && concurrently -k -n web,desktop -c cyan,yellow \"pnpm dev:web\" \"wait-on http://localhost:15174 && pnpm --filter @omniscribe/mcp-server build:dev && pnpm --filter @omniscribe/desktop dev:inspect\"",
    "dev:debug": "LOG_LEVEL=debug pnpm dev",
    "dev:web": "pnpm --filter @omniscribe/web dev",
    "screenshots": "node scripts/screenshot-app.mjs",
    "build": "pnpm build:packages && pnpm --filter @omniscribe/web build && pnpm --filter @omniscribe/mcp-server build && pnpm --filter @omniscribe/desktop build",
    "build:packages": "pnpm --filter @omniscribe/shared build && pnpm --filter @omniscribe/plugin-api build && concurrently \"pnpm --filter @omniscribe/provider-claude build\" \"pnpm --filter @omniscribe/provider-codex build\"",
    "package": "pnpm build && pnpm --filter @omniscribe/desktop package",
    "package:win": "pnpm build && pnpm --filter @omniscribe/desktop package:win",
    "package:mac": "pnpm build && pnpm --filter @omniscribe/desktop package:mac",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm -r run test",
    "test:cov": "pnpm build:packages && pnpm -r run test:cov",
    "typecheck": "pnpm build:packages && pnpm --filter @omniscribe/web typecheck && pnpm --filter @omniscribe/mcp-server typecheck && pnpm --filter @omniscribe/desktop typecheck",
    "docs:dev": "pnpm --filter @omniscribe/docs dev",
    "docs:build": "pnpm build:packages && pnpm --filter @omniscribe/docs build",
    "docs:serve": "pnpm --filter @omniscribe/docs start",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "wait-on": "^9.0.10"
  }
}
