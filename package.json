{
  "name": "omniscribe",
  "version": "1.6.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "undici": ">=7.24.0",
      "flatted": ">=3.4.2",
      "tar@>=6": ">=7.5.11",
      "hono": ">=4.12.14",
      "@hono/node-server": ">=1.19.13",
      "@xmldom/xmldom": ">=0.8.12 <0.9.0",
      "axios": ">=1.15.0",
      "follow-redirects": ">=1.16.0",
      "lodash": ">=4.18.0",
      "handlebars": ">=4.7.9",
      "multer": ">=2.1.1",
      "serialize-javascript": ">=7.0.5",
      "socket.io-parser": ">=4.2.6",
      "path-to-regexp@<1": ">=0.1.13 <0.2.0",
      "picomatch": ">=4.0.4",
      "file-type": ">=21.3.2",
      "brace-expansion@>=5": ">=5.0.5",
      "yaml@>=2": ">=2.8.3",
      "@tootallnate/once": ">=3.0.1",
      "postcss": ">=8.5.10",
      "ip-address": ">=10.1.1"
    }
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n web,desktop -c cyan,yellow \"pnpm dev:web\" \"wait-on http://localhost:15174 && pnpm --filter @omniscribe/mcp-server build:dev && pnpm --filter @omniscribe/desktop dev\"",
    "dev:debug": "LOG_LEVEL=debug pnpm dev",
    "dev:web": "pnpm --filter @omniscribe/web dev",
    "build": "pnpm build:packages && pnpm --filter @omniscribe/web build && pnpm --filter @omniscribe/mcp-server build && pnpm --filter @omniscribe/desktop build",
    "build:packages": "pnpm --filter @omniscribe/shared build && pnpm --filter @omniscribe/plugin-api build && concurrently \"pnpm --filter @omniscribe/provider-claude build\" \"pnpm --filter @omniscribe/provider-codex build\"",
    "package": "pnpm build && pnpm --filter @omniscribe/desktop package",
    "package:win": "pnpm build && pnpm --filter @omniscribe/desktop package:win",
    "package:mac": "pnpm build && pnpm --filter @omniscribe/desktop package:mac",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm -r run test",
    "test:cov": "pnpm build:packages && pnpm -r run test:cov",
    "typecheck": "pnpm build:packages && pnpm --filter @omniscribe/web typecheck && pnpm --filter @omniscribe/mcp-server typecheck && pnpm --filter @omniscribe/desktop typecheck",
    "docs:dev": "pnpm --filter @omniscribe/docs dev",
    "docs:build": "pnpm build:packages && pnpm --filter @omniscribe/docs build",
    "docs:serve": "pnpm --filter @omniscribe/docs start",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "wait-on": "^9.0.5"
  }
}
